{:paths ["src"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  metosin/malli {:mvn/version "0.20.2"}
  ;; A git dependency: not on Clojars yet. Required only once a problem needs a graph.
  io.github.robertluo/state-graph {:git/url "https://github.com/robertluo/state-graph"
                                   :git/sha "f5cd30a23a74a0973185624ea51cfd2f01b4ad5f"}}
 :aliases
 {;; test.check and kaocha are here; the runner is `clojure -M:dev:test`, never `-M:test` alone.
  :dev {:extra-paths ["dev" "test"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                     lambdaisland/kaocha {:mvn/version "1.91.1392"}}}
  :test {:main-opts ["-m" "kaocha.runner"]}
  ;; Clay notebooks under notebook/, run on top of :dev (`clojure -M:dev:notebook`) so they
  ;; instrument through robertluo.markov.instrument like the tests do. See clay.edn.
  :notebook {:extra-paths ["notebook"]
             :extra-deps {org.scicloj/clay {:mvn/version "2.0.23"}}}
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
          :main-opts ["-m" "nrepl.cmdline"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "RELEASE"}}
         :main-opts ["-m" "clj-kondo.main"]}}}
